{
  "name": "see-storycraft",
  "version": "0.1.0",
  "type": "module",
  "description": "故事工坊：长篇创作的动作集与编排工作台（作品、章节、真值、审稿、状态）。",
  "meta": {
    "title": "故事工坊",
    "description": "为长篇创作提供动作集与一个只读编排工作台；人设、技能与脚本跟随预设。"
  },
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skills": "./lib/skills.js",
    "./tools": "./lib/tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dehuadong/dsh-nove.git",
    "directory": "storycraft"
  },
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "fiction",
    "writing",
    "workbench"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:local": "node scripts/install-local.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/pack-check.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
