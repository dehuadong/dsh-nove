{
  "name": "dsh-storycraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "故事工坊：长篇创作的动作集与编排工作台（作品、章节、真值、审稿、状态）。",
  "meta": {
    "title": "故事工坊",
    "description": "为长篇创作提供动作集与一个只读编排工作台；人设、技能与脚本跟随预设。"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./skills": "./skills.js",
    "./tools": "./tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "skills.js",
    "tools.js",
    "db.js",
    "domain.js",
    "storage.js",
    "materials.js",
    "search-text.js",
    "chapter-edit.js",
    "style.js",
    "epub.js",
    "store-db.js",
    "state-validation.js",
    "state-check.js",
    "state-settle.js",
    "bible.js",
    "volumes.js",
    "critique.js",
    "facts.js",
    "context.js",
    "retrieval.js",
    "landing.js",
    "role-input.js",
    "revision.js",
    "submission.js",
    "delegate.js",
    "scope.js",
    "consistency.js",
    "current.js",
    "proposals.js",
    "cordis.patch.yml",
    "icon.svg",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
