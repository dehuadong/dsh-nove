{
  "name": "dsh-storycraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "故事工坊：长篇创作的动作集与编排工作台（作品、章节、真值、审稿、状态）。",
  "meta": {
    "title": "故事工坊",
    "description": "为长篇创作提供动作集与一个只读编排工作台；人设、技能与脚本跟随预设。"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./skills": "./dist/skills.js",
    "./tools": "./dist/tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
